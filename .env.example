# Resend — transactional email for the contact form
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=your_key_here

# Where contact form submissions are delivered
CONTACT_EMAIL_TO=you@example.com

# Verified sender address (must be on a domain verified in Resend)
CONTACT_EMAIL_FROM=Website <noreply@example.com>
